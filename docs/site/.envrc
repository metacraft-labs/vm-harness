#!/usr/bin/env bash
# Self-contained dev shell for the vm-harness docs site.
#
# The site consumes the isonim-docs static-site framework, declared (together
# with isonim, the shared Nim libs, and the design system) as flake INPUTS in
# ./flake.nix — so it builds with NO sibling checkouts. This `.envrc` just
# enters that flake's own dev shell.
#
# WORKSPACE OVERRIDE: if you are hacking on the framework itself and have a live
# sibling checkout of isonim / isonim-docs next to a codetracer-ci-refactor
# workspace, point the pinned inputs at it with `--override-input` so your local
# edits are picked up instead of the pinned github revs (mirrors the pattern in
# codetracer/docs/book-isonim/.envrc). Adjust WORKSPACE to your checkout root.

source_url \
	"https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.4/direnvrc" \
	"sha256-DzlYZ33mWF/Gs8DDeyjr8mnVmQGx7ASYqA5WlxwvBG4="

dotenv_if_exists
watch_file .env
watch_file flake.nix
watch_file flake.lock

# Optional live-sibling overrides. Set VMH_DOCS_WORKSPACE to the directory that
# holds sibling isonim / isonim-docs / … checkouts to develop against them.
overrides=()
WORKSPACE="${VMH_DOCS_WORKSPACE:-}"
if [[ -n "$WORKSPACE" ]]; then
	for input in isonim isonim-docs nim-everywhere nim-faststreams nim-stew codetracer-design-system; do
		if [[ -d "$WORKSPACE/$input" ]]; then
			overrides+=(--override-input "$input" "path:$WORKSPACE/$input")
			watch_file "$WORKSPACE/$input/flake.nix"
		fi
	done
fi

use flake . "${overrides[@]}"
