<?xml version="1.0" encoding="utf-8"?>
<!--
  vm-harness Windows-on-x86_64 golden image autounattend.xml (M4
  libvirt slice, Phase A).

  Drives Windows 11 Pro 24H2 (amd64) Setup from first boot through
  to a desktop with OpenSSH server enabled and admin auto-logon.
  Adapted from guest-recipes/windows-arm-base/autounattend.xml:

    - processorArchitecture is "amd64" everywhere (vs "arm64").
    - The WindowsPE pass includes a <DriverPaths> block that pulls
      the virtio-blk + virtio-net storage/network drivers from the
      virtio-win driver disk that the libvirt backend's virt-install
      argv attaches as a second sata CD. Without this Windows Setup
      cannot see the virtio-blk system disk on the q35 board and
      stalls at "Select where to install Windows".
    - The autounattend is intended to be attached as a removable
      CD-ROM (FAT12/ISO9660 labelled AUTOUNATTEND); Windows Setup
      scans every attached removable medium at first boot.
    - The Win11 Pro install key (VK7JG-NPHTM-C97JM-9MPGT-3V66T) is
      the generic install key — Windows is unactivated post-install
      until the consumer applies a real key (out of scope for this
      recipe). For the windows-runner-001 prototype Windows runs in
      the 30-day grace period; productionization would activate via
      KMS or MAK.

  Differences from the Hyper-V Panther approach (and from
  windows-arm-base):

    - Includes the windowsPE pass with DiskConfiguration so Setup
      partitions disk 0 unattended.
    - <DriverPaths> wires in two paths under D: (the virtio-win CD
      that libvirt presents as the second sata drive — drive letters
      under WindowsPE are assigned by enumeration order, so the
      Windows install CD lands on E: and the virtio-win CD on D:
      with the q35 sata bus layout the libvirt backend uses).
    - FirstLogonCommands installs OpenSSH Server via DISM (no
      Windows Update dependency), enables sshd, and writes the
      install-done sentinel.

  Credentials baked in:

    - User: admin
    - Password: repro-windows-x64
    - Auto-logon enabled (so the FirstLogonCommands hook runs at
      first boot without needing console input).

  These match the LibvirtBackend defaults (newLibvirtBackend
  sshUser=admin, sshPassword=repro-windows-x64). Override by editing
  this file before running the recipe AND by constructing the
  backend with explicit sshUser/sshPassword.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UILanguageFallback>en-US</UILanguageFallback>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-PnpCustomizationsWinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- Inject virtio storage + network drivers in the WindowsPE
           phase so Setup can see the virtio-blk system disk and the
           virtio-net adapter that virt-install attached. Without
           this Setup stops at "We couldn't find any drives".

           The libvirt backend always attaches the virtio-win driver
           disk as a sata CD. Under WindowsPE drive letters are
           assigned in attach order; the layout the backend produces
           is: D: virtio-win.iso, E: Windows install ISO. If you
           change the bus order in the backend, update these paths. -->
      <!-- We list BOTH D: and E: candidates for each virtio path
           because WindowsPE's drive-letter assignment under q35 +
           sata depends on whether the boot CD ends up in the
           physical-drive list or gets re-mapped to X: as a RAM
           disk. Tiny11 25H2's WinPE leaves the boot CD enumerated
           — putting the Win11 install ISO on D: and the virtio-win
           CD on E:. Earlier WinPE builds (and the windows-arm-base
           recipe this was forked from) put the boot CD on X: and
           the virtio-win disk on D:. Listing both keeps the recipe
           working across either layout; PnpCustomizations skips
           candidates that don't exist.

           NB: removing this fallback in the past caused the install
           to stall after 20+ min with ~5 MB written to the qcow2 —
           Setup couldn't find virtio-blk drivers, so the
           DiskConfiguration pass had nowhere to install to. -->
      <DriverPaths>
        <PathAndCredentials wcm:action="add" wcm:keyValue="vio-storage-d">
          <Path>D:\amd64\w11</Path>
        </PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="vio-storage-e">
          <Path>E:\amd64\w11</Path>
        </PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="vio-net-d">
          <Path>D:\NetKVM\w11\amd64</Path>
        </PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="vio-net-e">
          <Path>E:\NetKVM\w11\amd64</Path>
        </PathAndCredentials>
      </DriverPaths>
    </component>

    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- Bypass Win11's system-requirements check. Required when the
           host CPU is not on Microsoft's approved list (e.g. high-mem-server's
           Sandy Bridge Xeon E5-2650 is too old), when virtualised TPM
           2.0 isn't exposed, or when SecureBoot can't be cleanly
           proven. Without these LabConfig keys Setup halts with
           "This PC can't run Windows 11" before partitioning the disk.
           This is the same bypass Rufus and Tiny11 builders apply. -->
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassTPMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassRAMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassCPUCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassSecureBootCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>5</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassStorageCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Type>EFI</Type>
              <Size>300</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Type>MSR</Type>
              <Size>128</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>3</Order>
              <Type>Primary</Type>
              <Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Label>System</Label>
              <Format>FAT32</Format>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>2</PartitionID>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>3</Order>
              <PartitionID>3</PartitionID>
              <Label>Windows</Label>
              <Letter>C</Letter>
              <Format>NTFS</Format>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
      </DiskConfiguration>
      <ImageInstall>
        <OSImage>
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>3</PartitionID>
          </InstallTo>
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows 11 Pro</Value>
            </MetaData>
          </InstallFrom>
        </OSImage>
      </ImageInstall>
      <UserData>
        <ProductKey>
          <!-- Generic Win11 Pro install-time key — Windows must be
               activated against a real key post-install if the
               recipe is used outside the disposable-per-gate
               context. -->
          <Key>VK7JG-NPHTM-C97JM-9MPGT-3V66T</Key>
          <WillShowUI>OnError</WillShowUI>
        </ProductKey>
        <AcceptEula>true</AcceptEula>
        <FullName>repro-vm-harness</FullName>
        <Organization>vm-harness</Organization>
      </UserData>
    </component>
  </settings>

  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>*</ComputerName>
      <TimeZone>UTC</TimeZone>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UILanguageFallback>en-US</UILanguageFallback>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <NetworkLocation>Work</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
        <SkipMachineOOBE>true</SkipMachineOOBE>
        <SkipUserOOBE>true</SkipUserOOBE>
      </OOBE>

      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>admin</Name>
            <Group>Administrators</Group>
            <Description>vm-harness Windows-x64 libvirt golden admin user</Description>
            <Password>
              <Value>repro-windows-x64</Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>

      <AutoLogon>
        <Username>admin</Username>
        <Password>
          <Value>repro-windows-x64</Value>
          <PlainText>true</PlainText>
        </Password>
        <Enabled>true</Enabled>
        <LogonCount>9</LogonCount>
      </AutoLogon>

      <FirstLogonCommands>
        <!-- 1. Wait for a routable IP. Without this the next step
             (Add-WindowsCapability OpenSSH.Server) silently fails
             because the capability resolver needs to reach Windows
             Update / the in-box source endpoint, and at first-logon
             the DHCP client typically hasn't yet acquired a lease
             (Windows shows 169.254/16 APIPA until ~30-60 s in). We
             poll Get-NetIPAddress for an interface with a default
             gateway, retrying up to 90 s before giving up (we don't
             want to block install-done indefinitely on a misconfigured
             host firewall — that's covered by follow-up). -->
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <CommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$deadline = (Get-Date).AddSeconds(90); while ((Get-Date) -lt $deadline) { try { if (Get-NetRoute -DestinationPrefix '0.0.0.0/0' -ErrorAction SilentlyContinue | Where-Object { $_.NextHop -ne '0.0.0.0' }) { break } } catch {}; Start-Sleep -Seconds 3 }"</CommandLine>
          <Description>Wait up to 90s for a default route (DHCP lease)</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 2. Install OpenSSH Server from the official PowerShell
             Win32-OpenSSH GitHub release. We deliberately do NOT use
             Add-WindowsCapability here: on a libvirt-NAT'd guest the
             capability resolver hits Microsoft Update CDN and hangs
             30+ minutes before either succeeding or silently failing,
             blocking the rest of the FirstLogonCommands chain. The
             portable .zip from PowerShell/Win32-OpenSSH is the same
             binaries Microsoft ships in the FOD; the .zip includes
             install-sshd.ps1 which registers the sshd service. -->
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <CommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $u='https://github.com/PowerShell/Win32-OpenSSH/releases/download/v9.5.0.0p1-Beta/OpenSSH-Win64.zip'; $z='C:\Windows\Temp\OpenSSH-Win64.zip'; $d='C:\Program Files\OpenSSH'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; Invoke-WebRequest -Uri $u -OutFile $z -UseBasicParsing; Expand-Archive -LiteralPath $z -DestinationPath 'C:\Program Files' -Force; if (Test-Path 'C:\Program Files\OpenSSH-Win64') { Move-Item -Force 'C:\Program Files\OpenSSH-Win64' $d }; powershell.exe -ExecutionPolicy Bypass -File (Join-Path $d 'install-sshd.ps1')"</CommandLine>
          <Description>Download + install Win32-OpenSSH from GitHub release</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 3. Configure sshd to start automatically and start it now.
             Also rewrite the default sshd_config to disable the
             FOD-default "Match Group administrators" block (DiD;
             we also dual-write the pubkey in step 8 so this regex
             miss is tolerated). -->
        <SynchronousCommand wcm:action="add">
          <Order>3</Order>
          <CommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Continue'; Set-Service -Name sshd -StartupType Automatic; $cfg='C:\ProgramData\ssh\sshd_config'; if (Test-Path $cfg) { $c = Get-Content $cfg; $c = $c -replace '^Match Group administrators.*','#Match Group administrators (commented by vm-harness)'; $c = $c -replace '^\s+AuthorizedKeysFile __PROGRAMDATA__/ssh/administrators_authorized_keys.*','#       AuthorizedKeysFile commented by vm-harness'; Set-Content -Path $cfg -Value $c -Encoding ASCII }; Start-Service sshd"</CommandLine>
          <Description>Enable + start sshd; neutralise admin-keys override</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 4. Open inbound TCP/22 on the firewall (the OpenSSH
             capability install does this, but we re-assert it
             defensively). -->
        <SynchronousCommand wcm:action="add">
          <Order>4</Order>
          <CommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "if (-not (Get-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -ErrorAction SilentlyContinue)) { New-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -DisplayName 'OpenSSH Server (sshd)' -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 }"</CommandLine>
          <Description>Ensure inbound TCP/22 is allowed</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 5. Install the virtio-win guest tools (qemu-ga +
             paravirt drivers MSI). The libvirt backend always attaches
             the virtio-win driver disk as a sata CD-ROM and the
             upstream Red Hat build puts virtio-win-guest-tools.exe at
             the disk's root, so we scan D-H for a matching path. -->
        <SynchronousCommand wcm:action="add">
          <Order>5</Order>
          <CommandLine>cmd.exe /c "for %i in (D E F G H) do if exist %i:\virtio-win-guest-tools.exe %i:\virtio-win-guest-tools.exe /quiet /norestart"</CommandLine>
          <Description>Install virtio-win guest tools (qemu-ga, paravirt MSI)</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 5. Install the controller's SSH public key into the admin
             user's authorized_keys, when build-autounattend-iso.sh was
             invoked with the controller-pubkey flag. The pubkey is
             staged at the root of the autounattend ISO as
             controller.pub; the PowerShell snippet scans removable
             drives for it (same reason the first-boot.ps1 lookup below
             does), copies it into C:\Users\admin\.ssh\authorized_keys,
             and tightens the ACL so only admin + SYSTEM can read it.
             Without this step the controller can't SSH into the guest
             on first boot and the operator has to paste the key in by
             hand via the console — see the M4 windows-runner-001
             bootstrap notes. -->
        <SynchronousCommand wcm:action="add">
          <Order>6</Order>
          <CommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "foreach ($d in 'D','E','F','G','H') { $p=$d+':\controller.pub'; if (Test-Path $p) { Copy-Item $p C:\Windows\Temp\controller.pub -Force; break } }"</CommandLine>
          <Description>Stage controller.pub on C:\Windows\Temp</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 7. Install controller pubkey into admin user's
             authorized_keys with strict ACLs. -->
        <SynchronousCommand wcm:action="add">
          <Order>7</Order>
          <CommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "if (Test-Path C:\Windows\Temp\controller.pub) { $k=(Get-Content -Raw C:\Windows\Temp\controller.pub).Trim(); $s='C:\Users\admin\.ssh'; New-Item -ItemType Directory -Force $s | Out-Null; $a=Join-Path $s 'authorized_keys'; Set-Content $a -Value $k -Encoding ASCII; icacls $s /inheritance:r /grant:r admin:F SYSTEM:F | Out-Null; icacls $a /inheritance:r /grant:r admin:F SYSTEM:F | Out-Null }"</CommandLine>
          <Description>Install pubkey into admin user authorized_keys</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 8. Mirror pubkey to administrators_authorized_keys so the
             FOD's "Match Group administrators" sshd_config block (if
             step 3's regex didn't catch it) still finds the key. -->
        <SynchronousCommand wcm:action="add">
          <Order>8</Order>
          <CommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "if (Test-Path C:\Windows\Temp\controller.pub) { $k=(Get-Content -Raw C:\Windows\Temp\controller.pub).Trim(); $a='C:\ProgramData\ssh\administrators_authorized_keys'; New-Item -ItemType Directory -Force (Split-Path $a) | Out-Null; Set-Content $a -Value $k -Encoding ASCII; icacls $a /inheritance:r /grant 'Administrators:F' /grant 'SYSTEM:F' | Out-Null }"</CommandLine>
          <Description>Mirror pubkey to administrators_authorized_keys</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 9. Stage the harness's first-boot bootstrap script onto C:\.
             The autounattend ISO carries first-boot.ps1 (when the
             operator supplied the first-boot-script flag to
             build-autounattend-iso.sh). The CMD-side `for` loop
             searches removable drives for it because drive letters
             under OOBE depend on the device attach order. -->
        <SynchronousCommand wcm:action="add">
          <Order>9</Order>
          <CommandLine>cmd.exe /c "for %i in (D E F G H) do if exist %i:\first-boot.ps1 copy /Y %i:\first-boot.ps1 C:\first-boot.ps1"</CommandLine>
          <Description>Stage first-boot.ps1 on C:\</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 10. Run the first-boot script if present (idempotent —
             the script itself is responsible for not re-running
             work on subsequent boots). -->
        <SynchronousCommand wcm:action="add">
          <Order>10</Order>
          <CommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "if (Test-Path C:\first-boot.ps1) { &amp; C:\first-boot.ps1 *&gt; C:\Windows\Temp\first-boot.log }"</CommandLine>
          <Description>Run first-boot.ps1 if present</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 11. Marker file the recipe scripts (and the libvirt
             backend's startAndAwaitReady) poll for. Written before
             shutdown so the controller can confirm via SSH after the
             VM is restarted that the install finished without
             aborting partway through. -->
        <SynchronousCommand wcm:action="add">
          <Order>11</Order>
          <CommandLine>cmd.exe /c "echo install-done > C:\Windows\Temp\repro-install-done"</CommandLine>
          <Description>Write install-done sentinel</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 12. Shut the guest down so the libvirt backend's
             virt-install wait flag sees the domain transition to
             "shut off" and treats that as install-complete. Without
             this, virt-install waits the full bootTimeoutSec (90
             min) and then returns a phantom timeout error even
             though the install actually finished cleanly. The
             controller restarts the VM in the next step
             (startAndAwaitReady) once provision returns. -->
        <SynchronousCommand wcm:action="add">
          <Order>12</Order>
          <CommandLine>cmd.exe /c "shutdown /s /t 5 /c \"vm-harness FirstLogonCommands complete; signalling install-done to virt-install\""</CommandLine>
          <Description>Shut down to signal install-complete to virt-install wait</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
      </FirstLogonCommands>

      <RegisteredOwner>vm-harness</RegisteredOwner>
      <RegisteredOrganization>Metacraft Labs</RegisteredOrganization>
      <TimeZone>UTC</TimeZone>
    </component>
  </settings>

</unattend>
