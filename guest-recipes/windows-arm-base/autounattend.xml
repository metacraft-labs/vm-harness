<?xml version="1.0" encoding="utf-8"?>
<!--
  vm-harness Windows-on-ARM golden image autounattend.xml (M3).

  Drives Windows 11 Arm64 Setup from first boot through
  to a desktop with OpenSSH server enabled and admin auto-logon. Mirrors
  the Hyper-V harness's Panther override pattern from
    reprobuild/tools/hyperv-m69-system/provision-base-vm.ps1
  (see New-PantherUnattendXml) but adapted for ISO-driven Setup rather
  than VHDX-shipped customization.

  Differences from the Hyper-V Panther approach:

    - Includes the windowsPE pass (disk partition + Setup auto-accept)
      because we're installing from ISO, not customizing a pre-baked
      VHDX. The Panther approach assumes Setup has already extracted
      the install; this approach drives Setup itself.
    - processorArchitecture="arm64" everywhere (vs amd64).
    - The specialize pass copies provision-openssh.ps1,
      provision-git.ps1 and, when present, openssh\OpenSSH-ARM64.zip,
      the git\ PortableGit archive, plus the
      virtio\NetKVM\w11\ARM64 driver directory from the autounattend
      ISO to C:\Windows\Temp while the install media is still attached.
      FirstLogonCommands runs that local copy to install OpenSSH
      Server via DISM, then falls back to the portable ARM64 zip when
      the Windows capability is unavailable. The helper also installs
      the ARM64 VirtIO NetKVM driver with pnputil when staged, so direct
      QEMU virtio-net boots can receive hostfwd SSH. Durable diagnostics
      go to C:\Windows\Temp\vmh-openssh-provision.log. OpenSSH or staged
      NetKVM install failure writes
      C:\Windows\Temp\vmh-openssh-provision-failed instead of the
      install-done sentinel.
      The Hyper-V harness deliberately removes OpenSSH because its
      transport is PSDirect; the UTM harness deliberately installs it
      because SSH is the only available transport over user-mode NAT.
    - FirstLogonCommands also install Git for Windows (PortableGit)
      and put C:\PortableGit\bin on the MACHINE PATH, which is what
      makes `bash.exe` reachable by a GitHub Actions runner service on
      clones of this golden. See guest-recipes/lib/provision-git.ps1.
    - Writes C:\Windows\Temp\repro-install-done as the "install
      finished" sentinel so the recipe scripts can poll for completion.
      NOTE: the sentinel is gated on OpenSSH only, not on Git — a Git
      failure leaves C:\Windows\Temp\vmh-git-provision-failed and is
      checked separately before SysPrep (README §"Verify before
      SysPrep").
    - Copies repro-sysprep.xml to C:\ for the manual step-5 SysPrep
      invocation (see README §5).

  Credentials baked in:

    - User: admin
    - Password: repro-windows-arm
    - Auto-logon enabled (so the FirstLogonCommands hook runs at first
      boot without needing console input).

  These match the UtmBackend defaults (newUtmBackend sshUser=admin,
  sshPassword=repro-windows-arm). Override by setting
  VMH_UTM_SSH_USER / VMH_UTM_SSH_PASSWORD in the test environment and
  by editing this file before running the recipe.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UILanguageFallback>en-US</UILanguageFallback>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Setup" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- Bypass Win11's system-requirements check for disposable
           golden-image creation under direct QEMU, where Secure Boot
           and virtual TPM are intentionally not exposed. Without these
           LabConfig keys Setup halts with "This PC can't run Windows 11"
           before partitioning the disk. -->
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassSecureBootCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassTPMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassRAMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Type>EFI</Type>
              <Size>300</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Type>MSR</Type>
              <Size>128</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>3</Order>
              <Type>Primary</Type>
              <Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Label>System</Label>
              <Format>FAT32</Format>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>2</PartitionID>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>3</Order>
              <PartitionID>3</PartitionID>
              <Label>Windows</Label>
              <Letter>C</Letter>
              <Format>NTFS</Format>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
      </DiskConfiguration>
      <ImageInstall>
        <OSImage>
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>3</PartitionID>
          </InstallTo>
          <!-- Pro is the most permissive SKU expected in Win11 Arm64
               ISOs; the recipe scripts validate the available
               image names and fall back to "Windows 11 Home" or
               "Windows 11 ARM" if Pro isn't present in the ISO. -->
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows 11 Pro</Value>
            </MetaData>
          </InstallFrom>
        </OSImage>
      </ImageInstall>
      <UserData>
        <ProductKey>
          <!-- Generic ARM Pro product key — install-time only; Windows
               must be activated against a real key post-install if the
               recipe is used outside the disposable-per-gate context. -->
          <Key>VK7JG-NPHTM-C97JM-9MPGT-3V66T</Key>
          <WillShowUI>OnError</WillShowUI>
        </ProductKey>
        <AcceptEula>true</AcceptEula>
        <FullName>repro-vm-harness</FullName>
        <Organization>vm-harness</Organization>
      </UserData>
    </component>
  </settings>

  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- Auto-generated by Setup so the golden bundle's clones each
           get a fresh name without us having to plug one in. -->
      <ComputerName>*</ComputerName>
      <TimeZone>UTC</TimeZone>
    </component>
    <component name="Microsoft-Windows-Deployment" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <!-- Stage the OpenSSH helper while the autounattend ISO is
             still mounted. FirstLogon runs after the install ISO has
             been removed, so it must not depend on removable media. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>cmd.exe /c "for %i in (D E F G H) do if exist %i:\provision-openssh.ps1 copy /Y %i:\provision-openssh.ps1 C:\Windows\Temp\provision-openssh.ps1"</Path>
          <Description>Stage OpenSSH provisioning script locally</Description>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>cmd.exe /c "for %i in (D E F G H) do if exist %i:\openssh\OpenSSH-ARM64.zip copy /Y %i:\openssh\OpenSSH-ARM64.zip C:\Windows\Temp\OpenSSH-ARM64.zip"</Path>
          <Description>Stage OpenSSH ARM64 portable zip locally when present</Description>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>cmd.exe /c "for %i in (D E F G H) do if exist %i:\virtio\NetKVM\w11\ARM64\netkvm.inf xcopy /E /I /Y %i:\virtio C:\Windows\Temp\virtio"</Path>
          <Description>Stage VirtIO NetKVM ARM64 driver locally when present</Description>
        </RunSynchronousCommand>
        <!-- Stage the Git for Windows helper and, when the operator ran
             ../lib/fetch-portable-git.sh, the pinned PortableGit arm64
             archive. Same reason as the OpenSSH staging above: the
             install media is gone by FirstLogon, so anything the
             FirstLogonCommands need must be copied to C: while it is
             still mounted. The helper itself also re-scans removable
             drives for the archive, which is harmless here and is what
             makes it usable standalone over SSH against an existing
             golden. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>cmd.exe /c "for %i in (D E F G H) do if exist %i:\provision-git.ps1 copy /Y %i:\provision-git.ps1 C:\Windows\Temp\provision-git.ps1"</Path>
          <Description>Stage Git for Windows provisioning script locally</Description>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>5</Order>
          <Path>cmd.exe /c "for %i in (D E F G H) do if exist %i:\git\*.7z.exe xcopy /E /I /Y %i:\git C:\Windows\Temp\git"</Path>
          <Description>Stage PortableGit arm64 archive locally when present</Description>
        </RunSynchronousCommand>
        <!-- Stage the Git verification GATE. Unlike the x64 recipe, this
             golden is captured by a MANUAL SysPrep (README §5) with no
             build-sysprep-golden.sh to run the gate automatically, so the
             script has to already be in the guest for step 5's single
             hard-failing command to work. provision-git.ps1 exits 0 even on
             failure; this is what turns that into a refusal to ship a
             Git-less image rather than a marker file nobody reads. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>6</Order>
          <Path>cmd.exe /c "for %i in (D E F G H) do if exist %i:\assert-git-provisioned.ps1 copy /Y %i:\assert-git-provisioned.ps1 C:\Windows\Temp\assert-git-provisioned.ps1"</Path>
          <Description>Stage the Git provisioning gate script locally</Description>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UILanguageFallback>en-US</UILanguageFallback>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <NetworkLocation>Work</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
        <SkipMachineOOBE>true</SkipMachineOOBE>
        <SkipUserOOBE>true</SkipUserOOBE>
      </OOBE>

      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>admin</Name>
            <Group>Administrators</Group>
            <Description>vm-harness Windows-ARM golden admin user</Description>
            <Password>
              <Value>repro-windows-arm</Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>

      <AutoLogon>
        <Username>admin</Username>
        <Password>
          <Value>repro-windows-arm</Value>
          <PlainText>true</PlainText>
        </Password>
        <Enabled>true</Enabled>
        <LogonCount>9</LogonCount>
      </AutoLogon>

      <FirstLogonCommands>
        <!-- 1. Make the local credential non-expiring.

             Windows' local MaxPasswordAge default is 42 days, so a golden
             captured today hands every clone a password that stops working
             six weeks later. That is not hypothetical: it happened to the
             x64 sibling of this recipe, whose `admin` password expired on
             2026-08-03 and took the documented `ssh admin@<ip>` retrofit
             route down with it. This recipe creates its account with the
             same shape, so it carries the same fix.

             `net accounts /maxpwage:unlimited` is the machine-wide half;
             it also covers accounts this image does not create itself. The
             ADSI half sets ADS_UF_DONT_EXPIRE_PASSWD (0x10000) on `admin`
             itself so a later policy change cannot silently re-arm the
             expiry. ADSI rather than Set-LocalUser because the
             Microsoft.PowerShell.LocalAccounts module is not dependable on
             Windows-on-ARM.

             `admin` is created by the UserAccounts block in this same
             oobeSystem pass, so this cannot run any earlier than
             FirstLogonCommands. It is first in the chain because the steps
             below can block on the network or on staged media. -->
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <CommandLine><![CDATA[powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "net.exe accounts /maxpwage:unlimited | Out-Null; try { $u=[ADSI]'WinNT://./admin,user'; $u.UserFlags.Value=$u.UserFlags.Value -bor 0x10000; $u.CommitChanges() } catch { }; exit 0"]]></CommandLine>
          <Description>Make local account passwords non-expiring</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 2. Disable every sleep, hibernate and idle timeout, on both
             the AC and the DC rail.

             A live ephemeral x64 runner suspended itself to S3 in the
             middle of a job because its golden retained Windows' default
             sleep idle timer; long jobs reach it and hang until the
             orchestrator times them out. This golden has the same default,
             so it gets the same treatment before it can bite here too.

             Both rails matter: a VM has no battery, but with no AC adapter
             exposed Windows can apply the DC profile anyway. Display and
             disk timeouts are meaningless on a headless guest and are
             cleared with the rest. `powercfg /hibernate off` deletes
             hiberfil.sys (RAM-sized, and it would otherwise ride along in
             every capture) and disables fast startup.

             The payload passes no double-quoted argument to a native
             command: `powershell.exe` here is Windows PowerShell 5.1,
             which does not escape embedded double quotes when it builds a
             native command line. -->
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <CommandLine><![CDATA[powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "foreach ($s in 'standby-timeout-ac','standby-timeout-dc','hibernate-timeout-ac','hibernate-timeout-dc','monitor-timeout-ac','monitor-timeout-dc','disk-timeout-ac','disk-timeout-dc') { powercfg.exe /x $s 0 | Out-Null }; powercfg.exe /hibernate off | Out-Null; exit 0"]]></CommandLine>
          <Description>Disable sleep, hibernation and idle timeouts</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 3. Provision OpenSSH Server with durable diagnostics. The
             install-done marker below is intentionally gated on this
             command's success marker/state so a guest that reaches the
             desktop without sshd does not look provisioned. -->
        <SynchronousCommand wcm:action="add">
          <Order>3</Order>
          <CommandLine><![CDATA[powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$p='C:\Windows\Temp\provision-openssh.ps1'; if (Test-Path -LiteralPath $p) { & $p } else { Set-Content -LiteralPath 'C:\Windows\Temp\vmh-openssh-provision-failed' -Value 'provision-openssh.ps1 not found' -Encoding UTF8 -Force }; exit 0"]]></CommandLine>
          <Description>Provision OpenSSH Server with diagnostics</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 4. Install Git for Windows (PortableGit) and put
             C:\PortableGit\bin on the MACHINE PATH.

             Git for Windows is what supplies bash.exe. Without it every
             GitHub Actions `shell: bash` step fails with "bash: command
             not found" and actions/checkout falls back to the REST-API
             tarball ("add Git 2.18 or higher to the PATH"). This golden
             had no Git at any stage, same as its x64 sibling.

             MACHINE PATH is the load-bearing detail: the actions runner
             runs as a SERVICE, and services.exe builds the environment
             block it hands to services once at boot from
             HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\
             Environment. A user-PATH edit is invisible to it. Because
             the edit lands here — in the golden, before SysPrep and
             capture — every clone's boot-time services.exe picks it up
             from the registry.

             The helper is idempotent, pins the PortableGit version and
             SHA-256, uses the arm64 asset, and writes
             C:\Windows\Temp\vmh-git-provision-failed on failure. It
             exits 0 either way so it cannot wedge the sentinel step
             below; see README §"Verify before SysPrep". -->
        <SynchronousCommand wcm:action="add">
          <Order>4</Order>
          <CommandLine><![CDATA[powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$p='C:\Windows\Temp\provision-git.ps1'; if (Test-Path -LiteralPath $p) { & $p -Arch arm64 } else { Set-Content -LiteralPath 'C:\Windows\Temp\vmh-git-provision-failed' -Value 'provision-git.ps1 not found' -Encoding UTF8 -Force }; exit 0"]]></CommandLine>
          <Description>Install Git for Windows on the machine PATH</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 5. Copy the SysPrep answer file from the autounattend ISO
             to C:\ so the manual step-5 SysPrep invocation finds it. -->
        <SynchronousCommand wcm:action="add">
          <Order>5</Order>
          <CommandLine>cmd.exe /c "for %i in (D E F G H) do if exist %i:\repro-sysprep.xml copy /Y %i:\repro-sysprep.xml C:\repro-sysprep.xml"</CommandLine>
          <Description>Stage repro-sysprep.xml on C:\</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>

        <!-- 6. Marker file the recipe scripts poll for. Written only if
             OpenSSH provisioning did not leave a failure marker and the
             sshd service is running. If OpenSSH is unavailable, inspect
             C:\Windows\Temp\vmh-openssh-provision.log and
             C:\Windows\Temp\vmh-openssh-provision-failed. -->
        <SynchronousCommand wcm:action="add">
          <Order>6</Order>
          <CommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "if ((Test-Path -LiteralPath 'C:\Windows\Temp\vmh-openssh-provision-failed') -or ((Get-Service -Name sshd -ErrorAction SilentlyContinue).Status -ne 'Running')) { exit 0 }; Set-Content -LiteralPath 'C:\Windows\Temp\repro-install-done' -Value 'install-done' -Encoding ASCII -Force; exit 0"</CommandLine>
          <Description>Write install-done sentinel after OpenSSH is ready</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
      </FirstLogonCommands>

      <RegisteredOwner>vm-harness</RegisteredOwner>
      <RegisteredOrganization>Metacraft Labs</RegisteredOrganization>
      <TimeZone>UTC</TimeZone>
    </component>
  </settings>

</unattend>
