#!/usr/bin/env bash
# repo-workspaces managed pre-push hook
#
# Hook management policy:
# - User or external hooks are chained by the dispatcher installed at the
#   standard Git hook path.
# - This file is the repo-workspaces-managed implementation and should be
#   installed under a recognizable repo-workspaces-managed filename.

set -euo pipefail

find_framework() {
    if [[ -n "${REPO_WORKSPACES_FRAMEWORK:-}" ]] && [[ -d "$REPO_WORKSPACES_FRAMEWORK/bin" ]]; then
        echo "$REPO_WORKSPACES_FRAMEWORK"
        return 0
    fi

    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/../repo-workspaces/bin" ]]; then
            echo "$dir/../repo-workspaces"
            return 0
        fi
        if [[ -d "$dir/repo-workspaces/bin" ]]; then
            echo "$dir/repo-workspaces"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

FRAMEWORK_DIR=$(find_framework) || exit 0

# Re-entry guard: a managed hook can trigger git operations -- notably the
# pre-push workspace-lock publish, which commits and pushes the manifest
# repo -- that fire further managed hooks. Without this guard those nested
# invocations recurse without bound and the push hangs (a fork bomb). The
# first hook claims the guard; nested invocations no-op.
if [ -n "${REPO_WORKSPACES_HOOK_ACTIVE:-}" ]; then
    exit 0
fi
export REPO_WORKSPACES_HOOK_ACTIVE=1
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
export REPO_WORKSPACES_HOOK_REPO_ROOT="$REPO_ROOT"
cd "$REPO_ROOT"
TMP_DIR="${TMPDIR:-/tmp}"
REFS_FILE="$TMP_DIR/repo-workspaces-pre-push-$$.refs"
cleanup() {
    rm -f "$REFS_FILE"
}
trap cleanup EXIT
cat >"$REFS_FILE"
exec "$FRAMEWORK_DIR/bin/workspace" __hook pre-push --refs-file "$REFS_FILE" "$@"

